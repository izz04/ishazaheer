    {
      "id": "07",
      "title": "The Copy",
      "caption": "",
      "works": [
        {
          "id": "07-1",
          "title": "Statue in the Garden",
          "caption": "The little metal sunflower in the middle of the garden is trying very hard to be a Jeff Koons sculpture — shiny, upright, permanently on duty. It even looks up toward its role model: a sunflower on a small pedestal by the window. But the real original isn’t outside at all. It’s the soft crochet sunflower by my bedside, the first version that quietly “lights” my room at night. The one on the classroom windowsill is its institutional cousin, doing the same job for everyone else: a tiny, handmade light source for the whole class. Like Koons’s balloon dogs, these flowers move from private kitsch to public monument — from bedside trinket to garden statue — asking how far a small, sentimental object can climb up the art-world ladder without losing its glow.",
          "image": "collection/copy/1.jpg",
          "sculpture": "sculpture/sunflower"
        },
        {
          "id": "07-2",
          "title": "Sunflower on the Pedestal",
          "caption": "The little metal sunflower in the middle of the garden is trying very hard to be a Jeff Koons sculpture — shiny, upright, permanently on duty. It even looks up toward its role model: a sunflower on a small pedestal by the window. But the real original isn’t outside at all. It’s the soft crochet sunflower by my bedside, the first version that quietly “lights” my room at night. The one on the classroom windowsill is its institutional cousin, doing the same job for everyone else: a tiny, handmade light source for the whole class. Like Koons’s balloon dogs, these flowers move from private kitsch to public monument — from bedside trinket to garden statue — asking how far a small, sentimental object can climb up the art-world ladder without losing its glow.",
          "image": "collection/copy/2.jpg"
        },
