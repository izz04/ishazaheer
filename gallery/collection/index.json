    {
      "id": "07",
      "title": "The Copy",
      "caption": "",
      "works": [
        {
          "id": "07-1",
          "title": "Statue in the Garden",
          "caption": "A 3D scan of a crocheted sunflower kept by the artist’s bedside imagines it as a polished metal sculpture in a garden. The shape of the stitches carries over into the metal, bringing a trace of the original’s softness into a setting where the flower can be read as a monument.",
          "image": "collection/copy/1.jpg",
          "sculpture": "sculpture/sunflower"
        },
        {
          "id": "07-2",
          "title": "Sunflower on the Pedestal",
          "caption": "This work begins with a 3D scan of a crocheted sunflower the artist keeps by her bedside. It reimagines the flower on a classroom windowsill, where the ledge acts as a pedestal. A small change in placement turns a private keepsake into something a roomful of people can notice.",
          "image": "collection/copy/2.jpg"
        },
        {
          "id": "07-3",
          "title": "Tile",
          "caption": "Five ceramic copies of an itr (perfume) bottle are arranged across a patterned floor. Viewed from above, they seem to extend the tile’s design. Their shadows bring the bottles back into focus as objects with weight and depth.",
          "image": "collection/copy/3.jpg"
        },
        {
          "id": "07-4",
          "title": "Mushrooms",
          "caption": "These white forms are ceramic copies of an itr (perfume) bottle. Set among grass and fallen leaves, their rounded shapes suggest a cluster of mushrooms. The familiar setting is enough to make a perfume bottle look like something that grew there.",
          "image": "collection/copy/4.jpg"
        }
      ]
    },
    {
      "id": "08",
      "title": "Printmaking",
      "caption": "",
      "works": [
        {
          "id": "08-1",
          "title": "Queen of Hearts",
          "caption": "The artwork explores self-love through two ways of making an impression. The photographic portrait is rendered in halftone dots, while the artist made the lipstick marks herself by deliberately kissing the paper. The figure looks at herself as though she were looking at someone else, raising a question: Is it easier to show ourselves affection when we step outside our usual way of seeing ourselves?",
          "image": "collection/printmaking/1.jpg"
        },
        {
          "id": "08-2",
          "title": "Under a Lucknow Arch",
          "caption": "Inspired by an arch in Lucknow, the City of Nawabs, this print brings together a hand-drawn stencil and a texture printed directly from jute cloth. Deep blue flowers evoke royalty, while the coarse weave of the jute cuts diagonally across the arch. The print places the grandeur of Lucknow’s architecture alongside the texture of an everyday material.",
          "image": "collection/printmaking/2.jpg"
        }
      ]
    }
  ]
